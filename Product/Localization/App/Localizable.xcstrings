          }
        }
      }
    },
    "The extension status has not been updated for more than 15 seconds. Pasu FS cannot confirm that protection is still running." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램 상태가 15초 넘게 갱신되지 않았습니다. 보호가 계속되는지 확인할 수 없습니다."
          }
        }
      }
    },
    "The extension still answers, so protection continues." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
