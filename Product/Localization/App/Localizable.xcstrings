      }
    },
    "The extension still answers." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램은 계속 응답합니다."
          }
        }
      }
    },
    "The extension stores a different policy set. Pasu FS is loading the saved policies again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램에 다른 정책 세트가 저장되어 있습니다. Pasu FS가 저장된 정책을 다시 불러옵니다."
          }
        }
      }
    },
    "The extension that is running keeps checking requests until this Mac restarts. macOS then starts %@." : {
