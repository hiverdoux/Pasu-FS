#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "${3:-}" = / ] || { echo 'Unexpected installation volume.' >&2; exit 1; }
helper=/Library/PrivilegedHelperTools/com.example.pasu.fs.maintenance
daemon=/Library/LaunchDaemons/com.example.pasu.fs.maintenance.plist
"$helper" --verify-installed
"$helper" --register-authorization-rights
if /bin/launchctl print system/com.example.pasu.fs.maintenance >/dev/null 2>&1; then
  /bin/launchctl bootout system/com.example.pasu.fs.maintenance
fi
/bin/launchctl bootstrap system "$daemon"
/bin/launchctl print system/com.example.pasu.fs.maintenance >/dev/null
# Opening the app lets it ask macOS to update a running extension with the one just installed, so
# a restart after the installation completes the update. The app opens only for the user logged in at the
# screen and with that user's identity, never as root. Installations with the installer command,
# which sets COMMAND_LINE_INSTALL, or with nobody at the screen skip this step; any failure here
# leaves the installation successful.
open_app_for_console_user() {
  [ -z "${COMMAND_LINE_INSTALL:-}" ] || return 1
  console_user=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null) || return 1
  case "$console_user" in ''|root|loginwindow|_mbsetupuser) return 1;; esac
  console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null) || return 1
  case "$console_uid" in ''|0|*[!0-9]*) return 1;; esac
  /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open '/Applications/Pasu FS.app'
}
if open_app_for_console_user; then
  echo 'Pasu FS application files are installed. Pasu FS was opened to update the extension and check protection.'
else
  echo 'Pasu FS application files are installed. Open Pasu FS from Applications to update the extension, check protection and complete any macOS approvals.'
fi
