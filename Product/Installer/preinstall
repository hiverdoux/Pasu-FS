#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "${3:-}" = / ] || { echo 'Pasu FS can only be installed on the running startup volume.' >&2; exit 1; }
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
version=$(/bin/cat "$script_dir/build-version")
"$script_dir/pasu-fs-maintenance" --preflight "$version"
# Never deactivate the Endpoint Security extension to update application files.
if /bin/launchctl print system/com.example.pasu.fs.maintenance >/dev/null 2>&1; then
  /bin/launchctl bootout system/com.example.pasu.fs.maintenance
fi
